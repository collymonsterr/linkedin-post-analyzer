{
  "manifest_version": 3,
  "name": "LinkedIn Post Analyzer",
  "version": "1.1",
  "description": "Scrape and analyze your LinkedIn posts with rich analytics, hook analysis, hashtag insights, and expert recommendations.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Post Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["analyze.html"],
    "matches": ["<all_urls>"]
  }]
}